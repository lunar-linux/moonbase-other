          MODULE=wsdd2
         VERSION=0.9
          SOURCE=$MODULE-$VERSION.tar.gz
 SOURCE_URL_FULL=https://github.com/christgau/wsdd/archive/refs/tags/v$VERSION.tar.gz
      SOURCE_VFY=sha256:009efafb763686d9e265ca8f1dd17696bc80fc0ee619f48ea7878ec21471f61e
SOURCE_DIRECTORY=$BUILD_DIRECTORY/wsdd-$VERSION
        WEB_SITE=https://github.com/christgau/wsdd
         ENTERED=20240925
         UPDATED=20250829
           SHORT="WSD/LLMNR Discovery/Name Service Daemon"

cat << EOF
wsdd implements a Web Service Discovery host daemon. This enables (Samba) hosts,
like your local NAS device, to be found by Web Service Discovery Clients like Windows.

It also implements the client side of the discovery protocol which allows to search
for Windows machines and other devices implementing WSD. This mode of operation is called discovery mode.
EOF
