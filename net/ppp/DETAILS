          MODULE=ppp
         VERSION=2.5.5
          SOURCE=$MODULE-$VERSION.tar.gz
 SOURCE_URL_FULL=https://github.com/ppp-project/ppp/archive/refs/tags/v${VERSION}.tar.gz
      SOURCE_VFY=sha256:c75b2ee2cbc6f16407e2a908f5ae5802a2f8717d19a8faf0262d1bfa3cc4ba27
        WEB_SITE=https://ppp.samba.org/
         ENTERED=20010922
         UPDATED=20261102
           SHORT="A server/client for for point to point protocol"

cat << EOF
PPP Daemon for Linux, Solaris 2, *BSD, SunOS 4, Digital Unix, SVR4,
NeXTStep, and Ultrix. This allows Unix machines to connect to the
internet through dialup lines, using the PPP protocol, as a PPP server
or client. Works with 'chat', 'dip', and 'diald', among (many) others.
Supports IP, TCP, UDP and (for Linux) IPX (Novell).
EOF
