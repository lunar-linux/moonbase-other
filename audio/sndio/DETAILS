          MODULE=sndio
         VERSION=1.11.0
          SOURCE=$MODULE-$VERSION.tar.gz
      SOURCE_URL=https://sndio.org/
      SOURCE_VFY=sha256:3e274b5968aa863090d6c6857d7df4f432cd0bafbe4d27312bdca34726eff1e8
        WEB_SITE=https://sndio.org/
