--- a/src/terminal.c
+++ b/src/terminal.c
@@ -36,6 +36,8 @@
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
+#include <xkbcommon/xkbcommon-keysyms.h>
+#include "clipboard_bridge.h"
 #include "asciinema.h"
 #include "conf.h"
 #include "config.h"
@@ -107,6 +109,7 @@ struct kmscon_terminal {
 	unsigned int font_size;
 
 	struct kmscon_pointer pointer;
+	struct clipboard_bridge *clipboard;
 
 	struct ev_timer *blink_timer;
 	struct ev_timer *blink_cursor;
@@ -954,6 +957,23 @@ static void zoom_out(struct kmscon_terminal *term)
 	terminal_update_size_notify(term);
 }
 
+static void paste_selection(struct kmscon_terminal *term);
+
+static void peer_paste(void *owner, const char *data, size_t size)
+{
+    struct kmscon_terminal *term = owner;
+    if (!term->opened || !term->awake ||
+        !kmscon_session_get_foreground(term->session))
+        return;
+    /* libtsm paste takes a terminated string, not a length. */
+    char *text = malloc(size + 1);
+    if (!text) return;
+    memcpy(text, data, size);
+    text[size] = '\0';
+    tsm_vte_paste(term->vte, text);
+    free(text);
+}
+
 static void input_event(struct input *input, struct input_key_event *ev, void *data)
 {
 	struct kmscon_terminal *term = data;
@@ -967,6 +987,27 @@ static void input_event(struct input *input, struct input_key_event *ev, void *d
 	    !kmscon_session_get_foreground(term->session))
 		return;
 
+	/* Preserve local paste even if no graphical peer was configured. */
+    /* Caps Lock must not disable clipboard shortcuts; other modifiers must. */
+    if ((ev->mods & ~INPUT_LOCK_MASK) == (INPUT_CONTROL_MASK | INPUT_SHIFT_MASK) &&
+        ev->num_syms == 1 && ev->keysyms) {
+        if (ev->keysyms[0] == XKB_KEY_C || ev->keysyms[0] == XKB_KEY_c) {
+            if (term->clipboard && term->pointer.copy_len > 0 && term->pointer.copy)
+                clipboard_bridge_copy(term->clipboard, term->pointer.copy,
+                                      (size_t)term->pointer.copy_len);
+            ev->handled = true;
+            return;
+        }
+        if (ev->keysyms[0] == XKB_KEY_V || ev->keysyms[0] == XKB_KEY_v) {
+            if (term->clipboard)
+                clipboard_bridge_paste(term->clipboard);
+            else
+                paste_selection(term);
+            ev->handled = true;
+            return;
+        }
+    }
+
 	// reset mouse selection on keypress
 	tsm_screen_selection_reset(term->console);
 	kmscon_asciinema_stop(term->asciinema);
@@ -1058,6 +1099,12 @@ static void copy_selection(struct kmscon_terminal *term)
 	term->pointer.copy_len = tsm_screen_selection_copy(term->console, &term->pointer.copy);
 }
 
+static void paste_selection(struct kmscon_terminal *term)
+{
+    if (term->pointer.copy && term->pointer.copy_len > 0)
+        tsm_vte_paste(term->vte, term->pointer.copy);
+}
+
 static void forward_pointer_event(struct kmscon_terminal *term, struct input_pointer_event *ev)
 {
 	unsigned int event;
@@ -1121,8 +1168,7 @@ static void handle_pointer_button(struct kmscon_terminal *term, struct input_poi
 		break;
 	case 1:
 		if (ev->pressed) {
-			if (term->pointer.copy && term->pointer.copy_len)
-				tsm_vte_paste(term->vte, term->pointer.copy);
+			paste_selection(term);
 			tsm_screen_selection_reset(term->console);
 		}
 		break;
@@ -1323,6 +1369,7 @@ static int terminal_open(struct kmscon_terminal *term)
 
 static void terminal_close(struct kmscon_terminal *term)
 {
+	clipboard_bridge_cancel(term->clipboard);
 	kmscon_asciinema_pause(term->asciinema);
 	kmscon_pty_close(term->pty);
 	term->opened = false;
@@ -1359,6 +1406,7 @@ void terminal_activate(struct kmscon_terminal *term)
 
 void terminal_deactivate(struct kmscon_terminal *term)
 {
+	clipboard_bridge_cancel(term->clipboard);
 	term->awake = false;
 	hw_cursor_hide(term);
 	if (term->conf->blink) {
@@ -1373,6 +1421,7 @@ void terminal_destroy(struct kmscon_terminal *term)
 	log_debug("free terminal object %p", term);
 
 	terminal_close(term);
+	clipboard_bridge_free(term->clipboard);
 	rm_all_screens(term);
 	ev_eloop_rm_timer(term->blink_timer);
 	ev_eloop_rm_timer(term->blink_cursor);
@@ -1452,6 +1501,12 @@ struct kmscon_terminal *terminal_new(struct kmscon_session *session, unsigned in
 	term->conf_ctx = conf_ctx;
 	term->conf = conf_ctx_get_mem(term->conf_ctx);
 
+	/* Explicit opt-in. Never guess a user session from a root process. */
+	const char *clip_path = getenv("KMSCON_CLIPBOARD_SOCKET");
+	if (clip_path && *clip_path)
+		term->clipboard = clipboard_bridge_new(eloop, clip_path, peer_paste, term);
+
+
 	ret = tsm_screen_new(&term->console, log_llog, NULL);
 	if (ret)
 		goto err_free;
@@ -1548,6 +1603,7 @@ err_vte:
 err_con:
 	tsm_screen_unref(term->console);
 err_free:
+	clipboard_bridge_free(term->clipboard);
 	free(term);
 	return NULL;
 }
