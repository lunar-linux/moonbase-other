diff --git a/src/clipboard_bridge.c b/src/clipboard_bridge.c
new file mode 100644
index 0000000..c349e56
--- /dev/null
+++ b/src/clipboard_bridge.c
@@ -0,0 +1,196 @@
+/* Minimal asynchronous client of the KMSCON X11 clipboard peer protocol. */
+#include "clipboard_bridge.h"
+#include "shl/eloop.h"
+#include <arpa/inet.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#define CLIP_LIMIT (64U * 1024U)
+#define CLIP_TIMEOUT_SEC 3
+
+enum phase { PH_CONNECT, PH_SEND, PH_RECEIVE };
+struct clipboard_bridge {
+    struct ev_eloop *loop;
+    struct ev_fd *watch;
+    struct ev_timer *timer;
+    int fd;
+    enum phase phase;
+    char operation;
+    char path[sizeof(((struct sockaddr_un *)0)->sun_path)];
+    unsigned char *out;
+    size_t out_len, out_at;
+    unsigned char *in;
+    size_t in_at, in_need;
+    clipboard_paste_cb on_paste;
+    void *owner;
+};
+
+void clipboard_bridge_cancel(struct clipboard_bridge *b)
+{
+    if (!b) return;
+    if (b->watch) { ev_eloop_rm_fd(b->watch); b->watch = NULL; }
+    if (b->fd >= 0) { close(b->fd); b->fd = -1; }
+    if (b->timer) { ev_timer_update(b->timer, NULL); ev_timer_disable(b->timer); }
+    free(b->out); b->out = NULL; b->out_len = b->out_at = 0;
+    free(b->in); b->in = NULL; b->in_at = b->in_need = 0;
+    b->operation = 0;
+}
+
+static void on_timeout(struct ev_timer *timer, uint64_t count, void *owner)
+{
+    (void)timer; (void)count;
+    clipboard_bridge_cancel(owner);
+}
+
+static void finish(struct clipboard_bridge *b)
+{
+    /* Callback is synchronous; copy into VTE before releasing the buffer. */
+    if (b->operation == 'P' && b->in_need >= 4 && b->in_at == b->in_need && b->in) {
+        uint32_t n;
+        memcpy(&n, b->in, 4);
+        n = ntohl(n);
+        if (n > 0 && n <= CLIP_LIMIT && b->on_paste && !memchr(b->in + 4, 0, n))
+            b->on_paste(b->owner, (const char *)b->in + 4, n);
+    }
+    clipboard_bridge_cancel(b);
+}
+
+static void on_socket(struct ev_fd *watch, int mask, void *owner)
+{
+    struct clipboard_bridge *b = owner;
+    (void)watch;
+    if (mask & EV_ERR) { clipboard_bridge_cancel(b); return; }
+    if (b->phase == PH_CONNECT && (mask & EV_WRITEABLE)) {
+        int error = 0; socklen_t len = sizeof(error);
+        struct ucred peer; socklen_t plen = sizeof(peer);
+        struct stat st;
+        if (getsockopt(b->fd, SOL_SOCKET, SO_ERROR, &error, &len) || error ||
+            getsockopt(b->fd, SOL_SOCKET, SO_PEERCRED, &peer, &plen) ||
+            lstat(b->path, &st) || !S_ISSOCK(st.st_mode) ||
+            st.st_uid != peer.uid || (st.st_mode & 0077) || peer.uid == 0) {
+            clipboard_bridge_cancel(b); return;
+        }
+        b->phase = PH_SEND;
+        ev_fd_update(b->watch, EV_WRITEABLE);
+    }
+    if (b->phase == PH_SEND && (mask & EV_WRITEABLE)) {
+        while (b->out_at < b->out_len) {
+            ssize_t n = send(b->fd, b->out + b->out_at, b->out_len - b->out_at, MSG_NOSIGNAL);
+            if (n < 0 && errno == EINTR) continue;
+            if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) return;
+            if (n <= 0) { clipboard_bridge_cancel(b); return; }
+            b->out_at += (size_t)n;
+        }
+        b->phase = PH_RECEIVE;
+        ev_fd_update(b->watch, EV_READABLE);
+    }
+    if (b->phase == PH_RECEIVE && (mask & (EV_READABLE | EV_HUP))) {
+        if (b->operation == 'C') {
+            char ack;
+            ssize_t n = recv(b->fd, &ack, 1, 0);
+            if (n != 0 && n < 0 && (errno == EAGAIN || errno == EINTR)) return;
+            clipboard_bridge_cancel(b);
+            return;
+        }
+        for (;;) {
+            size_t want = b->in_need - b->in_at;
+            ssize_t n = recv(b->fd, b->in + b->in_at, want, 0);
+            if (n < 0 && errno == EINTR) continue;
+            if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) return;
+            if (n <= 0) { clipboard_bridge_cancel(b); return; }
+            b->in_at += (size_t)n;
+            if (b->in_at != b->in_need) return;
+            if (b->in_need == 4) {
+                uint32_t size;
+                memcpy(&size, b->in, 4);
+                size = ntohl(size);
+                if (size == UINT32_MAX || size > CLIP_LIMIT) { clipboard_bridge_cancel(b); return; }
+                if (size == 0) { clipboard_bridge_cancel(b); return; }
+                b->in_need = 4 + size;
+                continue;
+            }
+            finish(b);
+            return;
+        }
+    }
+    if (mask & EV_HUP) clipboard_bridge_cancel(b);
+}
+
+struct clipboard_bridge *clipboard_bridge_new(struct ev_eloop *loop,
+                                               const char *path,
+                                               clipboard_paste_cb cb, void *owner)
+{
+    if (!loop || !path || !*path || strlen(path) >= sizeof(((struct clipboard_bridge *)0)->path))
+        return NULL;
+    struct clipboard_bridge *b = calloc(1, sizeof(*b));
+    if (!b) return NULL;
+    b->loop = loop; b->fd = -1;
+    b->on_paste = cb; b->owner = owner;
+    strcpy(b->path, path);
+    struct itimerspec initial = {0};
+    if (ev_eloop_new_timer(loop, &b->timer, &initial, on_timeout, b)) {
+        free(b); return NULL;
+    }
+    ev_timer_disable(b->timer);
+    return b;
+}
+
+static void begin(struct clipboard_bridge *b, char op, const char *data, size_t size)
+{
+    if (!b || (op == 'C' && (!data || size == 0 || size > CLIP_LIMIT || memchr(data, 0, size))))
+        return;
+    clipboard_bridge_cancel(b);
+    b->operation = op;
+    b->out_len = op == 'C' ? 5 + size : 1;
+    b->out = malloc(b->out_len);
+    if (!b->out) goto error;
+    b->out[0] = (unsigned char)op;
+    if (op == 'C') {
+        uint32_t net = htonl((uint32_t)size);
+        memcpy(b->out + 1, &net, 4);
+        memcpy(b->out + 5, data, size);
+    } else {
+        b->in = malloc(4 + CLIP_LIMIT);
+        if (!b->in) goto error;
+        b->in_need = 4;
+    }
+    b->fd = socket(AF_UNIX, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+    if (b->fd < 0) goto error;
+    struct sockaddr_un addr = {.sun_family = AF_UNIX};
+    strcpy(addr.sun_path, b->path);
+    int connected = connect(b->fd, (const struct sockaddr *)&addr, sizeof(addr));
+    if (connected != 0 && errno != EINPROGRESS) goto error;
+    b->phase = PH_CONNECT;
+    if (ev_eloop_new_fd(b->loop, &b->watch, b->fd, EV_WRITEABLE, on_socket, b)) goto error;
+    struct itimerspec deadline = {.it_value = {.tv_sec = CLIP_TIMEOUT_SEC}};
+    if (ev_timer_update(b->timer, &deadline)) goto error;
+    ev_timer_enable(b->timer);
+    return;
+error:
+    clipboard_bridge_cancel(b);
+}
+
+void clipboard_bridge_copy(struct clipboard_bridge *b, const char *data, size_t len)
+{
+    begin(b, 'C', data, len);
+}
+
+void clipboard_bridge_paste(struct clipboard_bridge *b)
+{
+    begin(b, 'P', NULL, 0);
+}
+
+void clipboard_bridge_free(struct clipboard_bridge *b)
+{
+    if (!b) return;
+    clipboard_bridge_cancel(b);
+    ev_eloop_rm_timer(b->timer);
+    free(b);
+}
diff --git a/src/clipboard_bridge.h b/src/clipboard_bridge.h
new file mode 100644
index 0000000..776adba
--- /dev/null
+++ b/src/clipboard_bridge.h
@@ -0,0 +1,16 @@
+/* Optional nonblocking link to an unprivileged graphical clipboard peer. */
+#ifndef KMSCON_CLIPBOARD_BRIDGE_H
+#define KMSCON_CLIPBOARD_BRIDGE_H
+#include <stddef.h>
+struct ev_eloop;
+struct clipboard_bridge;
+typedef void (*clipboard_paste_cb)(void *owner, const char *data, size_t length);
+struct clipboard_bridge *clipboard_bridge_new(struct ev_eloop *loop,
+                                              const char *socket_path,
+                                              clipboard_paste_cb paste_cb,
+                                              void *owner);
+void clipboard_bridge_copy(struct clipboard_bridge *b, const char *data, size_t length);
+void clipboard_bridge_paste(struct clipboard_bridge *b);
+void clipboard_bridge_cancel(struct clipboard_bridge *b);
+void clipboard_bridge_free(struct clipboard_bridge *b);
+#endif
