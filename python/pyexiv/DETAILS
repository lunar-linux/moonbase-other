          MODULE=pyexiv
         VERSION=2.16.0
          SOURCE=$MODULE-$VERSION.tar.gz
 SOURCE_URL_FULL=https://github.com/LeoHsiao1/pyexiv2/archive/refs/tags/v$VERSION.tar.gz
      SOURCE_VFY=sha256:23bcc1c3146ccb17f1913d53b8050f653c95e81cc2af5f09b34af2ced28a2c59
SOURCE_DIRECTORY=$BUILD_DIRECTORY/pyexiv2-$VERSION
        WEB_SITE=https://pypi.org/project/pyexiv2/
         ENTERED=20230125
         UPDATED=20261012
           SHORT="A Python-3 bindings to exiv2"

cat << EOF
pyexiv2 is a Python binding to exiv2, the C++ library for manipulation of EXIF,
IPTC and XMP image metadata. It is a python module that allows your python
scripts to read and write metadata (EXIF, IPTC, XMP, thumbnails) embedded in
image files (JPEG, TIFF, ...).
EOF
