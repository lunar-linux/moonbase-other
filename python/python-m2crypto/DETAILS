          MODULE=python-m2crypto
         VERSION=0.51.0
          SOURCE=m2crypto-$VERSION.tar.gz
      SOURCE_URL=https://pypi.io/packages/source/m/m2crypto/
      SOURCE_VFY=sha256:5428f6601086a8f5e41aa70248b3b983443e7badf263551c5104ba2ec0c9d955
SOURCE_DIRECTORY=$BUILD_DIRECTORY/m2crypto-$VERSION
        WEB_SITE=https://pypi.org/project/M2Crypto/
         ENTERED=20210420
         UPDATED=20261117
           SHORT="Python wrapper for OpenSSL"
cat << EOF
M2Crypto is the most complete Python wrapper for OpenSSL featuring RSA,
DSA, DH, HMACs, message digests, symmetric ciphers (including AES);
SSL functionality to implement clients and servers; HTTPS extensions to
Python's httplib, urllib, and xmlrpclib; unforgeable HMAC'ing AuthCookies for
web session management; FTP/TLS client and server; S/MIME; ZServerSSL: A HTTPS
server for Zope and ZSmime: An S/MIME messenger for Zope. M2Crypto can also be
used to provide SSL for Twisted.
EOF
