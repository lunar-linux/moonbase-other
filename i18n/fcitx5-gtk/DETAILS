            MODULE=fcitx5-gtk
           VERSION=5.1.7
            SOURCE=$MODULE-$VERSION.tar.gz
   SOURCE_URL_FULL=https://github.com/fcitx/$MODULE/archive/refs/tags/$VERSION.tar.gz
        SOURCE_VFY=sha256:92d7a5e3ed9eac8c8173983723013816f4706dddc3f019b4bb5c76c48cf4dd92
          WEB_SITE=https://github.com/fcitx/fcitx5-gtk
