 SOURCE_URL_FULL=https://github.com/dmtx/libdmtx/archive/v$VERSION.tar.gz
      SOURCE_VFY=sha256:2394bf1d1d693a5a4ca3cfcc1bb28a4d878bdb831ea9ca8f3d5c995d274bdc39
