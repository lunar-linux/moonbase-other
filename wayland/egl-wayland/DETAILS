          MODULE=egl-wayland
         VERSION=1.1.24
          SOURCE=$MODULE-$VERSION.tar.gz
 SOURCE_URL_FULL=https://github.com/NVIDIA/egl-wayland/archive/$VERSION.tar.gz
      SOURCE_VFY=sha256:4297ebcbe1476347519971c41be648e748aee0e2fdbff4a84bd3b52ef665dcab
        WEB_SITE=https://github.com/NVIDIA/egl-wayland
