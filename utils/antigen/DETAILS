 SOURCE_URL_FULL=https://github.com/zsh-users/antigen/archive/v$VERSION.tar.gz
      SOURCE_VFY=sha256:f84cb5ebe2416c7b43752954bc9d8e4c43ac18a8433ef9a5a890390c89fa92d3
        WEB_SITE=http://antigen.sharats.me/
