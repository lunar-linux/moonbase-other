          MODULE=bpftop
         VERSION=0.9.0
          SOURCE=$MODULE-$VERSION.tar.gz
 SOURCE_URL_FULL=https://github.com/jfernandez/bpftop/archive/refs/tags/v${VERSION}.tar.gz
      SOURCE_VFY=sha256:a81bcc69a697ffa0919d63394d914d4b1f15b2ba33d2c28e6f6dae2187f59a5a
        WEB_SITE=https://bpftop.sh
         ENTERED=20260801
         UPDATED=20260801
           SHORT="A CLI tool for dynamic real-time view of running eBPF programs"

cat << EOF
bpftop provides a dynamic real-time view of running eBPF programs. It displays
the average runtime, events per second, and estimated total CPU % for each
program. It also provides graphical views of these statistics over time.
This tool minimizes overhead by enabling performance statistics only while
it is active.
EOF
