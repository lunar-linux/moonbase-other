       MODULE=tmux
      VERSION=3.7c
       SOURCE=$MODULE-$VERSION.tar.gz
   SOURCE_URL=https://github.com/tmux/tmux/releases/download/$VERSION/
   SOURCE_VFY=sha256:7c60cae9a0e25288e2e24750aafc9e8800fc7fd4555e447e1b29ee4201cfb3bf
     WEB_SITE=https://tmux.github.io/
