if module_installed clang; then
  # Remove the broken clang because of the LLVM upgrade
  lrm clang &&
  # Rebuild with gcc
  lin -c clang
fi &&

if module_installed lld; then
  lin -c lld
fi &&

if module_installed compiler-rt; then
  lin -c compiler-rt
fi &&

if module_installed openmp; then
  lin -c openmp
fi &&

if module_installed lldb; then
  lin -c lldb
fi
