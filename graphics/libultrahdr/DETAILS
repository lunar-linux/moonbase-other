          MODULE=libultrahdr 
         VERSION=2.0.2
          SOURCE=$MODULE-$VERSION.tar.gz
 SOURCE_URL_FULL=https://github.com/google/libultrahdr/archive/refs/tags/v$VERSION.tar.gz
      SOURCE_VFY=sha256:aa8d193bb887c348c419780511dd03b374f4e07af8812b6d3f80c8537cf1ef2c
        WEB_SITE=https://github.com/google/libultrahdr
            TYPE=cmake
         ENTERED=20240825
         UPDATED=20260902
           SHORT="store and distribute HDR images"

cat << EOF
An image compression library that uses gain map technology to store and
distribute HDR images. Conceptually on the encoding side, the library
accepts SDR and HDR rendition of an image and from these a Gain Map
(quotient between the two renditions) is computed.
EOF
