          MODULE=librsvg
         VERSION=2.62.4
          SOURCE=$MODULE-$VERSION.tar.gz
      SOURCE_URL=https://gitlab.gnome.org/GNOME/librsvg/-/archive/$VERSION/
      SOURCE_VFY=sha256:83d2689f3ab78865ef9b250eb3ec09bd18c864d91e45d66e19ff60d7becfa23e
        WEB_SITE=http://www.gnome.org
         ENTERED=20020714
         UPDATED=20261001
           SHORT="A library for operating on files in SVG format"

cat << EOF
The librsvg library is a lightweight library for parsing and rendering vector-
graphic files in SVG format (like the ones made by sodipodi). It also includes
functions that render anti-aliased fonts using freetype, including caching of
glyphs. It's used by Nautilus for drawing vector icons and anti-aliased type.
EOF
