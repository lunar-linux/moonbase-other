depends systemd
depends libusb
depends bluez-5
depends libdbi
depends curl
depends cmake

optional_depends libdbi     "-DWITH_LibDBI=ON"   "-DWITH_LibDBI=OFF"   "For LibDBI support"
optional_depends %MYSQL     "-DWITH_MySQL=ON"    "-DWITH_MySQL=OFF"    "For mysql database support"
optional_depends postgresql "-DWITH_Postgres=ON" "-DWITH_Postgres=OFF" "For PostgreSQL database support"

optional_depends doxygen    "-DWITH_Doxygen=ON -DINSTALL_DOC=ON" \
                            "-DWITH_Doxygen=OFF -DINSTALL_DOC=OFF" \
                            "For documentation install"
