          MODULE=protozero
         VERSION=1.8.2
          SOURCE=$MODULE-$VERSION.tar.gz
 SOURCE_URL_FULL=https://github.com/mapbox/protozero/archive/refs/tags/v$VERSION.tar.gz
      SOURCE_VFY=sha256:68d1df951b4d8397355c8fc9ffed40d9c06282a877fe847403feac6edcee3ef1
        WEB_SITE=https://github.com/mapbox/protozero
         ENTERED=20250817
         UPDATED=20260824
           SHORT="Minimalistic protocol buffer decoder and encoder in C++"

cat << EOF
Minimalistic protocol buffer decoder and encoder in C++. Designed for high performance.
Suitable for writing zero copy parsers and encoders with minimal need for run-time
allocation of memory. Low-level: this is designed to be a building block for writing a
very customized decoder for a stable protobuf schema. If your protobuf schema is changing
frequently or lazy decoding is not critical for your application then this approach offers
no value: just use the C++ API that can be generated with the Google Protobufs protoc program.
EOF
